### Unity
# Unity generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]in/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/

# Asset Store tools / Rider plugin
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Addressables build output
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Build output
*.apk
*.aab
*.unitypackage
.gradle/

# Autogenerated solution and project files
*.csproj
*.unityproj
*.sln
*.pidb
*.pidb.meta
*.mdb
*.mdb.meta
*.pdb
*.pdb.meta
*.opendb
*.VC.db
*.tmp

# Unity crash / analytics files
sysinfo.txt
crashlytics-build.properties

### Visual Studio
# Visual Studio cache/options directory
/.vs/

# User-specific files
*.suo
*.user
*.userprefs

# MSTest test results
/[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Publish output
*.[Pp]ublish.xml
/artifacts/
/publish/

### JetBrains
