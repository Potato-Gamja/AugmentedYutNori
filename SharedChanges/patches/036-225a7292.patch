+    private static string EffectName(string id) => id switch
+    {
+        "Contrarian" => "청개구리", "Monk" => "수행자", "Veteran" => "노장",
+        "Marathoner" => "마라토너", "Sprinter" => "스프린터", "Hunter" => "사냥꾼",
