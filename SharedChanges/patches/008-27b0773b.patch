+    private int GetConfiguredTeamCount()
+    {
+        int highestTeam = -1;
+        foreach (PieceView view in pieceViews)
+            if (view != null && view.Team > highestTeam) highestTeam = view.Team;
+
+        // 규격 확인 필요: GameSetup.teamCount가 준비되면 씬의 말 목록 대신 그 값을 사용한다.
